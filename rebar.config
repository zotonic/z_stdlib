{require_min_otp_vsn, "R16"}.

{erl_opts, [
    debug_info,
    warn_unused_vars, 
    warn_shadow_vars,
    warn_unused_import
]}.

{eunit_opts, [verbose]}.

{profiles, [
    {test, [
        {deps, [
            {proper, "1.5.0"},
            {mochiweb, {git, "https://github.com/zotonic/mochiweb.git", {branch, "master"}}}
        ]}
    ]}
]}.
